NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
ADMIN_EMAIL=you@example.com
LOCAL_AUTH_BYPASS=false

# Fare scanner: keep "mock" until you add a live provider key.
FLIGHT_PROVIDER=mock

# Recommended MVP provider: three Google Flights Deals searches per scan.
SERPAPI_API_KEY=your_serpapi_api_key
SERPAPI_MAX_DEALS=12
SERPAPI_MAX_PRICE=1000
DEAL_MIN_DISCOUNT_PERCENT=30

# Legacy/Enterprise option; new Amadeus Self-Service signup is unavailable.
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
AMADEUS_ENV=test
AMADEUS_MAX_DEALS=12
AMADEUS_MAX_PRICE=1000
